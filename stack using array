#include <stdio.h>
#define MAX 5
int stack[MAX];
int top = -1;

void push(int value){
    if(top == MAX-1){
        printf("Stack Overflow!");
    }
    else{
        top++;
        stack[top] = value;
        printf("%d pushed into stack!", value);
    }
}
void pop(){
    if(top == -1){
        printf("Stack underflow!");
    }
    else{
        printf("%d popped from stack", stack[top]);
        top--;
    }
}
void display(){
    if(top == -1){
        printf("Stack is empty");
    }
    else{
        printf("Stack elements are: \n");
        for(int i = top; i>=0; i--){
            printf("%d\n",stack[i]);
        }
    }
}
int main(){
    push(10);
    push(20);
    push(30);
    display();
    
    pop();
    display();
    
    return 0;
}
